# Copie este arquivo para .env (não commitado — está no .gitignore) e
# preencha com valores reais. O app carrega .env automaticamente se existir.

# Modo debug do Flask. "1" só em dev — NUNCA em produção.
FLASK_DEBUG=1

# Chave de sessão do Flask. Opcional em dev (FLASK_DEBUG=1); obrigatória fora
# disso. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credencial única exigida na tela de login (/login). Sempre obrigatórias.
AUTH_USER=admin
AUTH_PASSWORD=troque-isso

# Porta do servidor de desenvolvimento (run.py). Ignorada em produção via WSGI.
PORT=5000
